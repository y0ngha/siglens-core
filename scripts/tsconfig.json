{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "rootDir": "..",
        "paths": {
            "@/*": ["../src/*"]
        },
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false
    },
    "include": ["**/*.ts", "../src/__tests__/scripts/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
