{
    "name": "@y0ngha/siglens-core",
    "version": "0.1.0",
    "description": "Pure TypeScript core library for the Siglens stock analysis platform — indicators, candle patterns, analysis prompt builder, and thin infrastructure wrappers.",
    "license": "UNLICENSED",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20"
    },
    "packageManager": "yarn@4.12.0",
    "scripts": {
        "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "release": "release-it",
        "release:patch": "release-it patch",
        "release:minor": "release-it minor",
        "release:major": "release-it major"
    },
    "peerDependencies": {
        "@google/genai": "^1.50.1",
        "@upstash/redis": "^1.37.0"
    },
    "peerDependenciesMeta": {
        "@google/genai": {
            "optional": true
        },
        "@upstash/redis": {
            "optional": true
        }
    },
    "devDependencies": {
        "@google/genai": "^1.50.1",
        "@release-it/conventional-changelog": "^10.0.6",
        "@types/node": "^20.11.0",
        "@upstash/redis": "^1.37.0",
        "@vitest/coverage-v8": "^2.1.0",
        "eslint": "^9.18.0",
        "husky": "^9.1.7",
        "prettier": "^3.4.0",
        "release-it": "^19.2.4",
        "tsc-alias": "^1.8.10",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.20.0",
        "vitest": "^2.1.0"
    }
}
