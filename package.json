{
    "name": "@y0ngha/siglens-core",
    "version": "0.1.0",
    "description": "Pure TypeScript core library for the Siglens stock analysis platform — indicators, candle patterns, analysis prompt builder, and thin infrastructure wrappers.",
    "license": "UNLICENSED",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20"
    },
    "packageManager": "yarn@4.12.0",
    "scripts": {
        "build": "tsc && tsc-alias",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@vitest/coverage-v8": "^2.1.0",
        "eslint": "^9.18.0",
        "prettier": "^3.4.0",
        "tsc-alias": "^1.8.10",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.20.0",
        "vitest": "^2.1.0"
    }
}
