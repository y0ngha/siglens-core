{
    "name": "@y0ngha/siglens-core",
    "version": "2.25.2",
    "description": "TypeScript technical analysis library for stocks and crypto: indicators (RSI, MACD, Bollinger Bands, Ichimoku), candlestick and chart pattern detection, trading signals, fear and greed index, and LLM analysis prompts with response validation.",
    "license": "MIT",
    "author": "y0ngha <dev.y0ngha@gmail.com>",
    "homepage": "https://github.com/y0ngha/siglens-core#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/y0ngha/siglens-core.git"
    },
    "bugs": {
        "url": "https://github.com/y0ngha/siglens-core/issues"
    },
    "keywords": [
        "technical-analysis",
        "stock-analysis",
        "stock",
        "crypto",
        "trading-signals",
        "trading",
        "indicators",
        "rsi",
        "macd",
        "bollinger-bands",
        "candlestick-patterns",
        "chart-patterns",
        "pattern-recognition",
        "fear-and-greed-index",
        "ai-analysis",
        "llm",
        "korean-stocks",
        "typescript"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    },
    "packageManager": "yarn@4.18.0",
    "scripts": {
        "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json && tsc -p scripts/tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:staged": "eslint --fix",
        "test": "vitest run",
        "test:quiet": "vitest run --reporter=dot",
        "test:related": "vitest related --run --passWithNoTests",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:staged": "prettier --write --ignore-unknown",
        "doc": "typedoc",
        "doc:watch": "typedoc --watch",
        "prepare": "husky",
        "release": "dotenv -e .env.local -- release-it",
        "release:patch": "dotenv -e .env.local -- release-it patch",
        "release:minor": "dotenv -e .env.local -- release-it minor",
        "release:major": "dotenv -e .env.local -- release-it major"
    },
    "peerDependencies": {
        "@anthropic-ai/sdk": ">=0.128.0 <1",
        "@google/genai": "^2.24.0",
        "@upstash/redis": "^1.37.0",
        "openai": "^7.23.0"
    },
    "peerDependenciesMeta": {
        "@anthropic-ai/sdk": {
            "optional": true
        },
        "@google/genai": {
            "optional": true
        },
        "@upstash/redis": {
            "optional": true
        },
        "openai": {
            "optional": true
        }
    },
    "devDependencies": {
        "@anthropic-ai/sdk": "^0.128.0",
        "@google/genai": "^2.24.0",
        "@release-it/conventional-changelog": "^12.0.2",
        "@types/node": "^22.20.4",
        "@upstash/redis": "^1.39.0",
        "@vitest/coverage-v8": "^5.0.5",
        "dotenv-cli": "^11.0.0",
        "eslint": "^10.11.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "openai": "7.23.0",
        "prettier": "3.9.9",
        "release-it": "^21.1.0",
        "tsc-alias": "~1.8.17",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "browser": "./dist/index.client.js",
            "default": "./dist/index.js"
        }
    },
    "dependencies": {
        "jsonrepair": "^3.15.0"
    },
    "resolutions": {
        "basic-ftp": "^6.2.1",
        "undici@npm:7.29.0": "^7.29.1"
    }
}
