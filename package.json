{
    "name": "@y0ngha/siglens-core",
    "version": "1.4.0",
    "description": "Pure TypeScript core library for the Siglens stock analysis platform — indicators, candle patterns, analysis prompt builder, and thin infrastructure wrappers.",
    "license": "UNLICENSED",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20.3"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "packageManager": "yarn@4.12.0",
    "scripts": {
        "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:staged": "eslint --fix",
        "test": "vitest run",
        "test:quiet": "vitest run --reporter=dot",
        "test:related": "vitest related --run --passWithNoTests",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:staged": "prettier --write --ignore-unknown",
        "doc": "typedoc",
        "doc:watch": "typedoc --watch",
        "prepare": "husky",
        "release": "dotenv -e .env.local -- release-it",
        "release:patch": "dotenv -e .env.local -- release-it patch",
        "release:minor": "dotenv -e .env.local -- release-it minor",
        "release:major": "dotenv -e .env.local -- release-it major"
    },
    "peerDependencies": {
        "@upstash/redis": "^1.37.0"
    },
    "peerDependenciesMeta": {
        "@upstash/redis": {
            "optional": true
        }
    },
    "devDependencies": {
        "@release-it/conventional-changelog": "^10.0.6",
        "@types/node": "^20.11.0",
        "@upstash/redis": "^1.37.0",
        "@vitest/coverage-v8": "^2.1.0",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.18.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "prettier": "^3.4.0",
        "release-it": "^19.2.4",
        "tsc-alias": "^1.8.10",
        "tsx": "^4.22.4",
        "typedoc": "^0.28.19",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.20.0",
        "vitest": "^2.1.0"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "browser": "./dist/index.client.js",
            "default": "./dist/index.js"
        }
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.110.0",
        "@google/genai": "^2.10.0",
        "jsonrepair": "^3.14.0",
        "openai": "6.35.0"
    }
}
