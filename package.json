{
    "name": "@y0ngha/siglens-core",
    "version": "2.3.1",
    "description": "Pure TypeScript core library for the Siglens stock analysis platform — indicators, candle patterns, analysis prompt builder, and thin infrastructure wrappers.",
    "license": "UNLICENSED",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "packageManager": "yarn@4.18.0",
    "scripts": {
        "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:staged": "eslint --fix",
        "test": "vitest run",
        "test:quiet": "vitest run --reporter=dot",
        "test:related": "vitest related --run --passWithNoTests",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:staged": "prettier --write --ignore-unknown",
        "doc": "typedoc",
        "doc:watch": "typedoc --watch",
        "prepare": "husky",
        "release": "dotenv -e .env.local -- release-it",
        "release:patch": "dotenv -e .env.local -- release-it patch",
        "release:minor": "dotenv -e .env.local -- release-it minor",
        "release:major": "dotenv -e .env.local -- release-it major"
    },
    "peerDependencies": {
        "@upstash/redis": "^1.37.0"
    },
    "peerDependenciesMeta": {
        "@upstash/redis": {
            "optional": true
        }
    },
    "devDependencies": {
        "@release-it/conventional-changelog": "^12.0.2",
        "@types/node": "^22.20.4",
        "@upstash/redis": "^1.39.0",
        "@vitest/coverage-v8": "^5.0.1",
        "dotenv-cli": "^11.0.0",
        "eslint": "^10.11.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "prettier": "3.9.9",
        "release-it": "^21.1.0",
        "tsc-alias": "~1.8.17",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "browser": "./dist/index.client.js",
            "default": "./dist/index.js"
        }
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.128.0",
        "@google/genai": "^2.24.0",
        "jsonrepair": "^3.15.0",
        "openai": "7.23.0"
    }
}
